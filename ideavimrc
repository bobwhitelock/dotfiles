
" Source `vim-sensible` as not loaded by just sourcing Vimrc, so options from
" this (that also exist in IDEA vim emulation) are set.
source ~/.vim/plugged/vim-sensible/plugin/sensible.vim

source ~/.vimrc

" Enable `ideavim` versions of common plugins.
set surround
set commentary
set textobj-entire

" File search
" nmap <Leader>sf <action>(com.mituuz.fuzzier.search.Fuzzier)
nmap <C-p> <action>(com.mituuz.fuzzier.search.FuzzierVCS)

" Mover
" nmap <Leader>fm <action>(com.mituuz.fuzzier.operation.FuzzyMover)

" Grepping
" nmap <Leader>ss <action>(com.mituuz.fuzzier.grep.FuzzyGrepCI)
nmap <C-g> <action>(com.mituuz.fuzzier.grep.FuzzyGrep)
